{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "efortune-site",
  "main": "worker/worker.js",
  "compatibility_date": "2026-11-10",

  "workers_dev": false,
  "preview_urls": false,

  // Production: attach custom domains efortune.tech and www.efortune.tech in the
  // Cloudflare dashboard (routes / workers routes), not in this file until cutover is finalized.

  "vars": {
    "ALLOWED_HOSTS": "efortune.tech,www.efortune.tech",
    "SITE_ORIGIN": "https://efortune.tech"
  },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },

  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "ed@efortune.tech",
      "allowed_sender_addresses": ["noreply@fortwarp.com"]
    }
  ]

  // TURNSTILE_SECRET — set at deploy: npx wrangler secret put TURNSTILE_SECRET
}
